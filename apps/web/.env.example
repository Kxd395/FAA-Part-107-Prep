# Required in non-test environments (auth signing)
APP_AUTH_SECRET=replace-with-long-random-secret
MAGIC_LINK_SECRET=replace-with-long-random-secret

# App origin resolution for login/magic links
# Prefer APP_BASE_URL in production.
APP_BASE_URL=http://localhost:3000
# Optional allowlist fallback (comma-separated origins)
# APP_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# Question source
# Optional: when set, /api/questions pulls from remote JSON payload.
# QUESTION_SOURCE_URL=https://example.com/questions.json

# Google sign-in
# Optional: enables Google login button/client flow.
# Keep server/client IDs aligned to avoid token audience mismatch.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email delivery (magic links)
# Optional: when unset, magic links are logged to console in dev mode.
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=Part 107 Prep <noreply@example.com>

# Sync auth/session
# Optional but recommended when using /api/sync/* routes.
# SYNC_SIGNING_SECRET=replace-with-long-random-secret
# SYNC_API_TOKEN=replace-with-sync-api-token

# Supabase persistence (server-side user state + learning events + question issues)
# Optional: when omitted, these stores use local .data JSON files.
# IMPORTANT: NEXT_PUBLIC_* keys alone do not enable server persistence.
# You must set SUPABASE_SERVICE_ROLE_KEY for production persistence writes.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...server-role-key
# Optional fallback only (disabled by default; not recommended for server writes):
# SUPABASE_ANON_KEY=eyJ...anon-key
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=eyJ...publishable-key
# SUPABASE_ALLOW_PUBLISHABLE_FALLBACK=false
#
# Optional table name overrides:
# SUPABASE_TABLE_USER_STATE=part107_user_state
# SUPABASE_TABLE_LEARNING_EVENTS=part107_learning_events
# SUPABASE_TABLE_QUESTION_ISSUES=part107_question_issues
# Optional kill-switch:
# SUPABASE_PERSISTENCE_ENABLED=true

# Sync snapshot signatures
# Optional: if set, upload/download snapshot integrity signatures are enforced.
# SYNC_SNAPSHOT_HMAC_SECRET=replace-with-long-random-secret

# Managed sync store backend
# Optional: use remote sync store instead of local .data file persistence.
# SYNC_STORE_URL=https://sync-store.example.com
# SYNC_STORE_TOKEN=replace-with-sync-store-token

# Internal metrics gate
# Optional: protects /api/_internal/rate-limit-metrics endpoint.
# INTERNAL_METRICS_TOKEN=replace-with-internal-token

# Client analytics sink forwarding
# Optional: disabled by default. When enabled and URL is unset, events post to
# first-party ingestion route `/api/user/learning-events`.
# NEXT_PUBLIC_ANALYTICS_SINK_ENABLED=false
# NEXT_PUBLIC_ANALYTICS_SINK_URL=https://analytics.example.com/events
# NEXT_PUBLIC_ANALYTICS_SINK_TOKEN=replace-with-analytics-token
