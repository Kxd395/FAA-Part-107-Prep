{
  "name": "part107-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node ../../tools/check-node-version.js && bash ../../tools/clear-next-cache.sh && NODE_OPTIONS=--dns-result-order=ipv4first next dev --hostname localhost --port 3000",
    "dev:fast": "next dev",
    "dev:clean": "node ../../tools/check-node-version.js && bash ../../tools/clear-next-cache.sh && NODE_OPTIONS=--dns-result-order=ipv4first next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "supabase:check": "node scripts/check-supabase-persistence.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "google-auth-library": "^9.7.0",
    "lucide-react": "^0.400.0",
    "next": "^16.1.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
